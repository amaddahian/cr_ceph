# SUBCOMMAND: backup
# ══════════════════════════════════════════════════════════════════════

cmd_backup() {
  if [[ -z "$DATABASE" ]]; then
    error "Database name is required. Use -d <database>"
  fi

  if ! command -v cockroach >/dev/null 2>&1; then
    error "cockroach CLI not found on PATH. Install CockroachDB first."
  fi

  check_cockroach_connection
  load_s3_credentials

  local bucket_name="${URI_BUCKET:-$(state_get CEPH_BUCKET)}"
  bucket_name="${bucket_name:-${BUCKET}}"

  local s3_ep
  s3_ep="$(s3_endpoint_for_cockroach)"

  local s3_uri
  s3_uri="$(build_s3_uri "$bucket_name" "$s3_ep")"

  echo
  echo -e "${CYAN}━━━ Backup to S3 ━━━${NC}"
  echo
  echo "  CockroachDB : ${HOST}:${PORT} (tenant: ${TENANT})"
  echo "  Database    : ${DATABASE}"
  echo "  S3 bucket   : ${bucket_name}"
  echo "  S3 endpoint : ${s3_ep}"
  echo

  local backup_sql="BACKUP DATABASE ${DATABASE} INTO '${s3_uri}';"

  info "Backing up database '${DATABASE}' to S3..."
  echo "  SQL: BACKUP DATABASE ${DATABASE} INTO 's3://${bucket_name}/...';"
  echo
  local output
  output=$(run_cockroach_sql "$backup_sql")

  if echo "$output" | grep -qi "succeeded\|job"; then
    success "Backup of '${DATABASE}' completed."
    echo "$output" | sed 's/^/  /'
  else
    echo "$output" | sed 's/^/  /'
    error "Backup failed. See output above."
  fi
  echo
}

# ══════════════════════════════════════════════════════════════════════
# SUBCOMMAND: restore
# ══════════════════════════════════════════════════════════════════════

cmd_restore() {
  if [[ -z "$DATABASE" ]]; then
    error "Database name is required. Use -d <database>"
  fi
  if [[ -z "$RESTORE_AS" ]]; then
    error "Restore target name is required. Use --restore-as <name>"
  fi

  if ! command -v cockroach >/dev/null 2>&1; then
    error "cockroach CLI not found on PATH. Install CockroachDB first."
  fi

  check_cockroach_connection
  load_s3_credentials

  local bucket_name="${URI_BUCKET:-$(state_get CEPH_BUCKET)}"
  bucket_name="${bucket_name:-${BUCKET}}"

  local s3_ep
  s3_ep="$(s3_endpoint_for_cockroach)"

  local s3_uri
  s3_uri="$(build_s3_uri "$bucket_name" "$s3_ep")"

  echo
  echo -e "${CYAN}━━━ Restore from S3 ━━━${NC}"
  echo
  echo "  CockroachDB : ${HOST}:${PORT} (tenant: ${TENANT})"
  echo "  Source DB   : ${DATABASE}"
  echo "  Restore as  : ${RESTORE_AS}"
  echo "  S3 bucket   : ${bucket_name}"
  echo "  S3 endpoint : ${s3_ep}"
  echo

  info "Dropping '${RESTORE_AS}' if it exists..."
  run_cockroach_sql "DROP DATABASE IF EXISTS ${RESTORE_AS} CASCADE;" >/dev/null 2>&1

  local restore_sql="RESTORE DATABASE ${DATABASE} FROM LATEST IN '${s3_uri}' WITH new_db_name = '${RESTORE_AS}';"

  info "Restoring '${DATABASE}' as '${RESTORE_AS}' from S3..."
  echo "  SQL: RESTORE DATABASE ${DATABASE} FROM LATEST IN 's3://${bucket_name}/...' WITH new_db_name = '${RESTORE_AS}';"
  echo
  local output
  output=$(run_cockroach_sql "$restore_sql")

  if echo "$output" | grep -qi "succeeded\|job"; then
    success "Restore completed: '${DATABASE}' -> '${RESTORE_AS}'"
    echo "$output" | sed 's/^/  /'
  else
    echo "$output" | sed 's/^/  /'
    error "Restore failed. See output above."
  fi
  echo
}

