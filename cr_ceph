  backup_uri="s3://${bucket_name}?AWS_ACCESS_KEY_ID=${ACCESS_KEY}&AWS_SECRET_ACCESS_KEY=${SECRET_KEY}&AWS_ENDPOINT=${endpoint}&AWS_REGION=us-east-1&AWS_USE_PATH_STYLE=true"
  local cdc_uri
