# SUBCOMMAND: demo
# ══════════════════════════════════════════════════════════════════════

cmd_demo() {
  detect_runtime
  require_aws_cli

  if ! command -v cockroach >/dev/null 2>&1; then
    error "cockroach CLI not found on PATH. Install CockroachDB first."
  fi

  check_cockroach_connection
  load_s3_credentials

  local host_ep
  host_ep="$(state_get CEPH_HOST_ENDPOINT)"
  host_ep="${host_ep:-$(s3_endpoint_external)}"

  local s3_ep
  s3_ep="$(s3_endpoint_for_cockroach)"

  local bucket_name
  bucket_name="$(state_get CEPH_BUCKET)"
  bucket_name="${bucket_name:-${BUCKET}}"
  local cdc_bucket_name
  cdc_bucket_name="$(state_get CEPH_CDC_BUCKET)"
  cdc_bucket_name="${cdc_bucket_name:-${CDC_BUCKET}}"

  echo
  echo -e "${CYAN}━━━ S3GW Demo: Backup, Restore & CDC ━━━${NC}"
  echo
  echo "  CockroachDB : ${HOST}:${PORT} (tenant: ${TENANT})"
  echo "  S3 endpoint : ${s3_ep}"
  echo "  Bucket      : ${bucket_name}"
  echo "  CDC bucket  : ${cdc_bucket_name}"
  echo

  info "Ensuring buckets exist..."
  aws_s3 "$host_ep" s3 mb "s3://${bucket_name}" 2>/dev/null || true
  aws_s3 "$host_ep" s3 mb "s3://${cdc_bucket_name}" 2>/dev/null || true
  echo

  local backup_uri
  backup_uri="$(build_s3_uri "$bucket_name" "$s3_ep")"
  local cdc_uri
  cdc_uri="$(build_s3_uri "$cdc_bucket_name" "$s3_ep")"

  info "Step 1: Creating database ceph_demo"
  run_cockroach_sql "CREATE DATABASE IF NOT EXISTS ceph_demo;" echo
  echo

  info "Step 2: Creating table office_dogs"
  run_cockroach_sql "SET DATABASE = ceph_demo; CREATE TABLE IF NOT EXISTS office_dogs (id INT PRIMARY KEY, name STRING);" echo
  echo

  info "Step 3: Inserting initial data"
  run_cockroach_sql "SET DATABASE = ceph_demo; INSERT INTO office_dogs VALUES (1, 'Petee'), (2, 'Carl') ON CONFLICT DO NOTHING;" echo
  echo

  info "Step 4: Updating a record"
  run_cockroach_sql "SET DATABASE = ceph_demo; UPDATE office_dogs SET name = 'Petee H' WHERE id = 1;" echo
  echo

  info "Step 5: Creating employees table with foreign key"
  run_cockroach_sql "SET DATABASE = ceph_demo; CREATE TABLE IF NOT EXISTS employees (dog_id INT REFERENCES office_dogs (id), employee_name STRING);" echo
  echo

  info "Step 6: Enabling rangefeeds and creating changefeed to CDC bucket"
  run_cockroach_sql "SET CLUSTER SETTING kv.rangefeed.enabled = true;" echo
  run_cockroach_sql "SET DATABASE = ceph_demo; CREATE CHANGEFEED FOR TABLE office_dogs INTO '${cdc_uri}' WITH updated, resolved='10s';" echo
  echo

  info "Step 7: Inserting more data"
  run_cockroach_sql "SET DATABASE = ceph_demo; INSERT INTO office_dogs VALUES (3, 'Buddy'), (4, 'Max') ON CONFLICT DO NOTHING;" echo
  echo

  info "Step 8: Backing up database to S3"
  run_cockroach_sql "BACKUP DATABASE ceph_demo INTO '${backup_uri}';" echo
  echo

  info "Step 9: Restoring database from backup"
  run_cockroach_sql "DROP DATABASE IF EXISTS restored_ceph_demo CASCADE;" echo
  run_cockroach_sql "RESTORE DATABASE ceph_demo FROM LATEST IN '${backup_uri}' WITH new_db_name = 'restored_ceph_demo';" echo
  echo

  info "Step 10: Verifying restored data"
  run_cockroach_sql "SELECT * FROM restored_ceph_demo.office_dogs ORDER BY id;" echo
  echo

  echo -e "${GREEN}━━━ Demo complete ━━━${NC}"
  echo
  echo "  Backup bucket contents:"
  echo -e "  ${CYAN}\$ aws --endpoint-url '${host_ep}' s3 ls s3://${bucket_name}/${NC}"
  aws_s3 "$host_ep" s3 ls "s3://${bucket_name}/" 2>/dev/null || echo "  (empty or not accessible)"
  echo
  echo "  CDC bucket contents:"
  echo -e "  ${CYAN}\$ aws --endpoint-url '${host_ep}' s3 ls s3://${cdc_bucket_name}/${NC}"
  aws_s3 "$host_ep" s3 ls "s3://${cdc_bucket_name}/" 2>/dev/null || echo "  (empty or not accessible)"
  echo
}

# ══════════════════════════════════════════════════════════════════════
# SUBCOMMAND: cleanup
# ══════════════════════════════════════════════════════════════════════

cmd_cleanup() {
  detect_runtime

  echo
  echo -e "${CYAN}━━━ S3GW Cleanup ━━━${NC}"
  echo

  if $RUNTIME ps -a --format '{{.Names}}' | grep -qx "$CONTAINER_NAME"; then
    info "Stopping container '${CONTAINER_NAME}'..."
    $RUNTIME stop "$CONTAINER_NAME" >/dev/null 2>&1 || true
    info "Removing container '${CONTAINER_NAME}'..."
    $RUNTIME rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
    success "Container '${CONTAINER_NAME}' removed."
  else
    warning "No container named '${CONTAINER_NAME}' found."
  fi

  if [[ -n "$REMOVE_IMAGES" ]]; then
    info "Looking for S3GW-related images..."
    local imgs
    imgs="$($RUNTIME images --format '{{.Repository}}:{{.Tag}}' | grep -Ei 'ceph|s3gw' || true)"
    if [[ -z "$imgs" ]]; then
      echo "  No S3GW-related images found."
    else
      echo "  Removing images:"
      while IFS= read -r img; do
        [[ -z "$img" ]] && continue
        echo "    ${img}"
        $RUNTIME rmi -f "$img" >/dev/null 2>&1 || true
      done <<< "$imgs"
      success "Images removed."
    fi
  fi

  # Clear state
  if [[ -f "$STATE_FILE" ]]; then
    local tmp
    tmp=$(grep -v "^CEPH_" "$STATE_FILE" 2>/dev/null || true)
    printf '%s\n' "$tmp" > "$STATE_FILE"
  fi

  success "S3GW cleanup complete."
  echo
}

# ══════════════════════════════════════════════════════════════════════
# ARGUMENT PARSING
# ══════════════════════════════════════════════════════════════════════

SUBCOMMAND=""

if [[ $# -gt 0 && ! "$1" =~ ^-- ]]; then
  SUBCOMMAND="$1"
  shift
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    # Global
    --runtime)       RUNTIME="$2"; shift 2 ;;
    --container)     CONTAINER_NAME="$2"; shift 2 ;;
    --s3-port)       S3_PORT="$2"; shift 2 ;;
    --access-key)    ACCESS_KEY="$2"; shift 2 ;;
    --secret-key)    SECRET_KEY="$2"; shift 2 ;;
    --help)          usage ;;

    # Setup
    --image)         IMAGE="$2"; shift 2 ;;
    --network)       NETWORK="$2"; shift 2 ;;
    --bucket)        BUCKET="$2"; URI_BUCKET="$2"; shift 2 ;;
    --cdc-bucket)    CDC_BUCKET="$2"; shift 2 ;;
    --quota)         QUOTA="$2"; shift 2 ;;
    --osd-size)      OSD_SIZE="$2"; shift 2 ;;

    # URI
    --internal)      URI_MODE="internal"; shift ;;
    --external)      URI_MODE="external"; shift ;;

    # CockroachDB connection
    -h|--host)       HOST="$2"; shift 2 ;;
    -p|--port)       PORT="$2"; shift 2 ;;
    -U|--user)       USER="$2"; shift 2 ;;
    -d|--database)   DATABASE="$2"; shift 2 ;;
    -t|--tenant)     TENANT="$2"; shift 2 ;;
    --insecure)      INSECURE="1"; shift ;;
    --certs-dir)     CERTS_DIR="$2"; shift 2 ;;

    # Restore
    --restore-as)    RESTORE_AS="$2"; shift 2 ;;

    # Create-bucket
    --name)          NEW_BUCKET_NAME="$2"; shift 2 ;;

    # Cleanup
    --remove-images) REMOVE_IMAGES="1"; shift ;;

    *)
      error "Unknown option: $1. Use --help for usage."
      ;;
  esac
done

# ── Dependency check ──────────────────────────────────────────────────
# Validate all required tools upfront based on the subcommand so the user
# gets a single clear error before anything starts.

check_dependencies() {
  local missing=()

  # Container runtime — needed by all subcommands except uri
  case "${SUBCOMMAND}" in
    uri) ;;
    *)
      if [[ -n "$RUNTIME" ]]; then
        command -v "$RUNTIME" >/dev/null 2>&1 || missing+=("$RUNTIME (container runtime)")
      else
        if ! command -v podman >/dev/null 2>&1 && ! command -v docker >/dev/null 2>&1; then
          missing+=("podman or docker (container runtime)")
        fi
      fi
      ;;
  esac

  # curl — needed for setup readiness check
  case "${SUBCOMMAND}" in
    setup) command -v curl >/dev/null 2>&1 || missing+=("curl (S3GW readiness check)") ;;
  esac

  # awk — needed for disk space validation and size conversion
  case "${SUBCOMMAND}" in
    setup) command -v awk >/dev/null 2>&1 || missing+=("awk (disk space validation)") ;;
  esac

  # AWS CLI — required for bucket operations, optional warning for setup
  case "${SUBCOMMAND}" in
    list-buckets|create-bucket)
      command -v aws >/dev/null 2>&1 || missing+=("aws CLI (pip install awscli)")
      ;;
    demo)
      command -v aws >/dev/null 2>&1 || missing+=("aws CLI (pip install awscli)")
      ;;
    setup)
      if ! command -v aws >/dev/null 2>&1; then
        warning "AWS CLI not found. Setup will proceed but bucket creation will be skipped."
        echo "  Install via: pip install awscli"
        echo
      fi
      ;;
  esac

  # cockroach CLI — needed for SQL operations
  case "${SUBCOMMAND}" in
    backup|restore|list-backups|show-backup|demo)
      command -v cockroach >/dev/null 2>&1 || missing+=("cockroach CLI (CockroachDB SQL operations)")
      ;;
  esac

  if [[ ${#missing[@]} -gt 0 ]]; then
    echo -e "${RED}ERROR: Missing required dependencies for 'cr_ceph ${SUBCOMMAND}':${NC}" >&2
    for dep in "${missing[@]}"; do
      echo -e "${RED}  - ${dep}${NC}" >&2
    done
    echo >&2
    echo "Install the missing tools and try again." >&2
    exit 1
  fi
}

# Skip dependency check for help/usage
if [[ -n "${SUBCOMMAND}" ]]; then
  check_dependencies
fi

# ── Dispatch ──────────────────────────────────────────────────────────

case "${SUBCOMMAND}" in
  setup)         cmd_setup ;;
  status)        cmd_status ;;
  create-bucket) cmd_create_bucket ;;
  list-buckets)  cmd_list_buckets ;;
  list-backups)  cmd_list_backups ;;
  show-backup)   cmd_show_backup ;;
  uri)           cmd_uri ;;
  backup)        cmd_backup ;;
  restore)       cmd_restore ;;
  demo)          cmd_demo ;;
  cleanup)       cmd_cleanup ;;
  "")            usage ;;
  *)             error "Unknown subcommand: ${SUBCOMMAND}. Use --help for usage." ;;
esac
