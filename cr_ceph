  echo
  echo -e "${CYAN}━━━ CockroachDB S3 URIs (${URI_MODE} endpoint) ━━━${NC}"
  echo
  echo "CockroachDB  : ${HOST}:${PORT} (tenant: ${TENANT})"
  echo "Endpoint     : ${endpoint}"
  echo
  echo "BACKUP:"
  echo "  BACKUP DATABASE <dbname> INTO '${backup_uri}';"
  echo
  echo "RESTORE:"
  echo "  RESTORE DATABASE <dbname> FROM LATEST IN '${backup_uri}' WITH new_db_name = 'defaultdb_new';"
  echo
  echo "CHANGEFEED:"
  echo "  CREATE CHANGEFEED FOR TABLE <table> INTO '${cdc_uri}' WITH updated, resolved='10s';"
  echo
  echo "AWS CLI (from host):"
  local host_ep
  host_ep="$(state_get CEPH_HOST_ENDPOINT)"
  host_ep="${host_ep:-$(s3_endpoint_external)}"
