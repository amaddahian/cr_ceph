cmd_uri() {
  load_s3_credentials

  local bucket_name="${URI_BUCKET:-$(state_get CEPH_BUCKET)}"
  bucket_name="${bucket_name:-${BUCKET}}"

  local cdc_bucket_name
  cdc_bucket_name="$(state_get CEPH_CDC_BUCKET)"
